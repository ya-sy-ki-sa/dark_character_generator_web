{
  "name": "dark_character_generator_web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:pages": "npm run build && WRANGLER_LOG_PATH=.wrangler/logs wrangler pages dev dist --compatibility-date 2026-08-23",
    "build": "npm run typecheck && vite build",
    "build:functions": "WRANGLER_LOG_PATH=.wrangler/logs wrangler pages functions build functions --outdir .wrangler/functions-build --compatibility-date 2026-08-23",
    "preview": "vite preview",
    "typecheck": "npm run typecheck:app && npm run typecheck:config && npm run typecheck:functions",
    "typecheck:app": "tsc --noEmit --project tsconfig.json",
    "typecheck:config": "tsc --noEmit --project tsconfig.node.json",
    "typecheck:functions": "tsc --noEmit --project functions/tsconfig.json",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run format:check && npm run lint && npm test && npm run build && npm run build:functions"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260823.1",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.0",
    "oxfmt": "0.64.0",
    "oxlint": "1.79.0",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "wrangler": "4.125.0"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.17.0"
  },
  "packageManager": "npm@11.17.0",
  "allowScripts": {
    "esbuild": true,
    "fsevents@2.3.3": true,
    "workerd": true
  }
}
